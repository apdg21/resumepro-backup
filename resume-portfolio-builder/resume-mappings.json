  "style19": {
    "_note": "Unusually irregular: contact info, footer, and page title are each a single combined display STRING rather than separate fields — built here via 'compose' (a template string with {master.field.path} placeholders, plus a special {year} token). Skills/languages are plain string arrays. Uses 'duration'/'year' single strings for dates (built via joinFields) and 'position'/'description' instead of 'role'/'details'.",
    "scalar": {
      "fullName": "header",
      "summary": "about",
      "profileImage": "profilePhoto"
    },
    "compose": {
      "contact": { "template": "Email: {contact.email} | Phone: {contact.phone} | Location: {contact.location}" },
      "footer": { "template": "© {year} {fullName}. All rights reserved." },
      "htmlTitle": { "template": "{fullName} — {jobTitle}" }
    },
    "arrays": {
      "skills": { "targetPath": "skills", "scalarFromItem": "name" },
      "languages": { "targetPath": "languages", "scalarFromItem": "name" },
      "experience": {
        "targetPath": "experience",
        "itemMap": { "jobTitle": "position", "company": "company", "bullets": "description", "joinBulletsAs": "paragraph" },
        "joinFields": [ { "sourceFields": ["startDate", "endDate"], "targetField": "duration", "separator": " – " } ]
      },
      "education": {
        "targetPath": "education",
        "itemMap": { "degree": "degree", "institution": "institution" },
        "joinFields": [ { "sourceFields": ["startDate", "endDate"], "targetField": "year", "separator": " – " } ]
      },
      "references": {
        "targetPath": "references",
        "itemMap": { "name": "name", "title": "relationship" },
        "joinFields": [ { "sourceFields": ["phone", "email"], "targetField": "contact", "separator": " | " } ]
      }
    }
  },

  "style18": {
    "_note": "The most irregular template covered so far. Navigation menu, logo initials, and downloadCvLink are page CHROME, not resume content — deliberately left untouched. about.personalInfo is a generic [{label,value}] list (built via labelValueArray). contact.items is a generic [{icon,text,link}] list (built via contactItemsArray). KNOWN LIMITATIONS: language levels here are descriptive words ('Native'/'Fluent') but the master form collects a 0-100 number — the number will display as-is rather than a word. Reference photos/quotes and per-skill icons aren't collected by the master form and will be dropped. Social link icons default to whatever the template's own itemMap leaves (none provided).",
    "scalar": {
      "fullName": "hero.title",
      "jobTitle": "hero.subtitle",
      "summary": "about.text",
      "profileImage": "hero.profilePhoto"
    },
    "compose": {
      "pageTitle": { "template": "{fullName} — {jobTitle}" },
      "footer.copyright": { "template": "© {year} {fullName}. All rights reserved." }
    },
    "labelValueArray": {
      "about.personalInfo": {
        "targetPath": "about.personalInfo",
        "items": [
          { "label": "Name", "sourcePath": "fullName" },
          { "label": "Title", "sourcePath": "jobTitle" },
          { "label": "Email", "sourcePath": "contact.email" },
          { "label": "Location", "sourcePath": "contact.location" }
        ]
      }
    },
    "contactItemsArray": {
      "contact.items": {
        "targetPath": "contact.items",
        "items": [
          { "sourcePath": "contact.email", "icon": "fas fa-envelope", "linkTemplate": "mailto:{value}" },
          { "sourcePath": "contact.phone", "icon": "fas fa-phone", "linkTemplate": "tel:{value}" }
        ]
      }
    },
    "arrays": {
      "skills": { "targetPath": "skills", "itemMap": { "name": "name", "level": "level" } },
      "languages": { "targetPath": "languages", "itemMap": { "name": "name", "level": "level" } },
      "experience": {
        "targetPath": "experience",
        "itemMap": { "jobTitle": "title", "company": "company", "bullets": "description", "joinBulletsAs": "paragraph" },
        "joinFields": [ { "sourceFields": ["startDate", "endDate"], "targetField": "date", "separator": " – " } ]
      },
      "education": {
        "targetPath": "education",
