  "style13": {
    "_note": "no profile image field. Uses combined date-range strings ('years', 'period') instead of separate start/end fields — see joinFields. Experience has a single 'description' string, not a bullets array. Education uses 'university' instead of 'institution'. Socials live under contact.social, not footer.socials.",
    "scalar": {
      "fullName": "name",
      "jobTitle": "title",
      "summary": "about",
      "contact.email": "contact.email",
      "contact.phone": "contact.phone",
      "contact.location": "contact.address",
      "contact.website": "contact.website"
    },
    "arrays": {
      "skills": { "targetPath": "skills", "itemMap": { "name": "name", "level": "level" } },
      "languages": { "targetPath": "languages", "itemMap": { "name": "name", "level": "level" } },
      "experience": {
        "targetPath": "experience",
        "itemMap": { "jobTitle": "title", "company": "company", "bullets": "description", "joinBulletsAs": "paragraph" },
        "joinFields": [ { "sourceFields": ["startDate", "endDate"], "targetField": "period", "separator": " – " } ]
      },
      "education": {
        "targetPath": "education",
        "itemMap": { "degree": "degree", "institution": "university" },
        "joinFields": [ { "sourceFields": ["startDate", "endDate"], "targetField": "years", "separator": " – " } ]
      },
      "socialLinks": { "targetPath": "contact.social", "itemMap": { "platform": "name", "url": "url" } }
    }
  },

  "style14": {
    "_note": "Skills are grouped by category ([{category,items:[...]}]) — since the master form doesn't collect categories, all skills go into one group labeled 'Skills' (via groupedArrays). about.description is an array of paragraphs, not a single string — the one summary field is wrapped in a single-element array (via scalar's wrapInArray). hero.title here is the person's TAGLINE/job title, not their name (profile.name holds the actual name). KNOWN LIMITATIONS: hero.image (decorative work photo), about.stats, and awards are template-only bonus sections not collected by the master form, left untouched. about.personal_info.availability (a status message) is also left as the template's own default, since only its sibling email/location fields are touched.",
    "scalar": {
      "fullName": "profile.name",
      "jobTitle": "hero.title",
      "summary": { "path": "about.description", "wrapInArray": true },
      "profileImage": "profile.image",
      "contact.email": "contact.email",
      "contact.phone": "contact.phone",
      "contact.location": "contact.location"
    },
    "compose": {
      "title": { "template": "{fullName} | {jobTitle}" },
      "footer.copyright": { "template": "© {year} {fullName}. All rights reserved." }
    },
    "arrays": {
      "experience": {
        "targetPath": "experience",
        "itemMap": { "jobTitle": "title", "company": "company", "bullets": "responsibilities" },
        "joinFields": [ { "sourceFields": ["startDate", "endDate"], "targetField": "date", "separator": " – " } ]
      },
      "education": {
        "targetPath": "education",
        "itemMap": { "degree": "title", "institution": "institution", "description": "description" },
        "joinFields": [ { "sourceFields": ["startDate", "endDate"], "targetField": "date", "separator": " – " } ]
      },
      "socialLinks": { "targetPath": "profile.social_links", "itemMap": { "platform": "platform", "url": "url" } }
    },
    "groupedArrays": {
      "skillsAndLanguages": {
        "targetPath": "skills",
        "groupField": "category",
        "itemsField": "items",
        "groups": [
          { "sourcePath": "skills", "groupValue": "Skills", "itemMap": { "name": "name", "level": "progress" } },
          { "sourcePath": "languages", "groupValue": "Languages", "itemMap": { "name": "name", "level": "progress" } }
        ]
      }
    }
  },

